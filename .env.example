# Neo4j配置
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=你的Neo4j密码
NEO4J_DATABASE=nutrition

# LLM配置
LLM_PROVIDER=kimi
LLM_MODEL=moonshot-v1-8k

# API密钥
OPENAI_API_KEY=你的OpenAI密钥（如果使用OpenAI）
ANTHROPIC_API_KEY=你的Anthropic密钥（如果使用Anthropic）
MOONSHOT_API_KEY=你的Kimi密钥（如果使用Kimi）

# API Base URL（可选，用于自定义API地址或使用代理）
KIMI_API_BASE_URL=https://api.moonshot.cn/v1
OPENAI_API_BASE_URL=https://api.openai.com/v1
